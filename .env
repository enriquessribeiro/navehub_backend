# Porta em que o servidor Express sobe localmente.
PORT=3333
NODE_ENV=development

# Connection string do Supabase (Project Settings -> Database).
# DATABASE_URL: connection pooler (transaction mode) — usada em runtime.
# DIRECT_URL: conexão direta — usada só ao rodar `prisma migrate`.
DATABASE_URL="postgresql://postgres.bfjtwibljtkpccopqnzu:alexcudedurex@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres:alexcudedurex@db.bfjtwibljtkpccopqnzu.supabase.co:5432/postgres"

# Chave secreta que protege a rota POST /api/sync/enem. Gere algo aleatório
# (ex.: `openssl rand -hex 32`) e configure o mesmo valor no agendador (cron)
# que vai chamar essa rota em produção.
SYNC_SECRET="cf4d40794cf1cdecc6797e96f229a19b78b0b1b5782586c8d8317757254b1362"

# Normalmente não precisa mudar — endpoint base da API pública do ENEM.
ENEM_API_BASE_URL="https://api.enem.dev/v1"

# Origem permitida para CORS (URL do frontend em produção). Use "*" em dev.
CORS_ORIGIN="*"
